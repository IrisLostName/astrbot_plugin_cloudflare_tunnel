{
  "cloudflared_enable": {"type": "bool", "description": "启用 cloudflared 守护", "default": false},
  "cloudflared_path": {"type": "string", "description": "容器内 cloudflared 路径", "default": "/AstrBot/data/bin/cloudflared"},
  "cloudflared_token": {"type": "string", "description": "Tunnel token（优先使用环境变量）", "default": ""},
  "cloudflared_restart_delay_seconds": {"type": "int", "description": "重启等待秒数", "default": 10},
  "cloudflared_crash_limit": {"type": "int", "description": "连续崩溃熔断上限", "default": 10},
  "runtime_state_dir": {"type": "string", "description": "持久化运行目录", "default": ""},
  "health_check_enable": {"type": "bool", "description": "启用内部健康检查", "default": true},
  "health_check_interval_minutes": {"type": "int", "description": "检查间隔", "default": 5},
  "health_check_timeout_seconds": {"type": "int", "description": "请求超时", "default": 8},
  "health_check_failure_restart_threshold": {"type": "int", "description": "连续失败重启阈值", "default": 3},
  "extra_health_checks": {"type": "template_list", "description": "内部健康检查", "default": []},
  "notify_targets": {"type": "list", "description": "通知会话", "default": []},
  "notify_on_error": {"type": "bool", "description": "故障通知", "default": true},
  "public_status_url": {"type": "string", "description": "Bot 公网边缘检查地址，302/403 代表 Access 边缘可达", "default": "https://bot.tomori.cloud/"},
  "public_status_expected_statuses": {"type": "list", "description": "公网边缘可接受状态码", "default": [200, 302, 403]}
}
